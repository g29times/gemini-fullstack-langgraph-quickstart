# GEMINI_API_KEY=

# Effort-level completion thresholds (0-1)
# Lower means easier to finalize early; higher means stricter evidence required
# Defaults correspond to Configuration defaults if unset
EFFORT_LOW_COMPLETION_THRESHOLD=0.50
EFFORT_MEDIUM_COMPLETION_THRESHOLD=0.65
EFFORT_HIGH_COMPLETION_THRESHOLD=0.80

# Effort-level max parallel queries override
# If unset, falls back to MAX_PARALLEL_QUERIES
# Recommended: low=1, medium=2-3, high=3-5 (tune based on rate limits)
EFFORT_LOW_MAX_PARALLEL_QUERIES=1
EFFORT_MEDIUM_MAX_PARALLEL_QUERIES=3
EFFORT_HIGH_MAX_PARALLEL_QUERIES=5

# Global research controls
ENABLE_PARALLEL_RESEARCH=true
MAX_PARALLEL_QUERIES=3
NUMBER_OF_INITIAL_QUERIES=3
MAX_RESEARCH_LOOPS=3

# Intent router and follow-up detection
ENABLE_INTENT_ROUTER=true
INTENT_CONFIDENCE_THRESHOLD=0.70
FOLLOW_UP_CONFIDENCE_THRESHOLD=0.70

# Early finalize and dynamic parallel gates ("main threshold + buffer")
# Finalize decent gate = max(FINALIZE_DECENT_MIN_FLOOR, EFFORT_*_COMPLETION_THRESHOLD - FINALIZE_DECENT_BUFFER)
FINALIZE_DECENT_BUFFER=0.10
FINALIZE_DECENT_MIN_FLOOR=0.70

# Dynamic parallelism controls
# First loop: if progress >= max(PARALLEL_LOW_PROGRESS_FLOOR, thr - PARALLEL_REDUCE_BUFFER) -> small k
PARALLEL_REDUCE_BUFFER=0.20
# PARALLEL_LOW_PROGRESS_FLOOR=0.40
# PARALLEL_LOW_PROGRESS_RATIO=0.60
# Later loops: low_progress_gate = min(PARALLEL_LOW_PROGRESS_FLOOR, thr * PARALLEL_LOW_PROGRESS_RATIO)
# Scheme A (config-only) recommendation:
#   Increase the later-loop small-parallel gate so that when new queries appear later,
#   the dispatcher more often uses small parallelism (k <= 2) instead of sequential.
#   Note: achieving k=3 in later loops requires a code change; config alone caps small parallel at 2.
PARALLEL_LOW_PROGRESS_FLOOR=0.90
PARALLEL_LOW_PROGRESS_RATIO=1.00